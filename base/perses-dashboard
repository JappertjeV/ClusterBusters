apiVersion: perses.dev/v1alpha1
kind: PersesDashboard
metadata:
  name: upgrade-readiness
spec:
  display:
    name: "OpenShift Upgrade Readiness"
  panels:
    # --- Bovenste rij: Status Tellers (StatChart) ---
    stat-blocking-pdbs:
      kind: Panel
      spec:
        display:
          name: "Blokkerende PDBs (0 Allowed Disruptions)"
          description: "Aantal PDBs met 0 toegestane evicties. Blokkeert node drains tijdens upgrades."
        plugin:
          kind: StatChart
          spec:
            calculation: last
            queries:
              - kind: PrometheusTimeSeriesQuery
                spec:
                  query: count(kube_poddisruptionbudget_status_pod_disruptions_allowed == 0) or vector(0)

    stat-unready-nodes:
      kind: Panel
      spec:
        display:
          name: "Nodes Niet Ready"
          description: "Aantal cluster-nodes waarvan de Ready condition niet 'true' is."
        plugin:
          kind: StatChart
          spec:
            calculation: last
            queries:
              - kind: PrometheusTimeSeriesQuery
                spec:
                  query: count(kube_node_status_condition{condition="Ready", status!="true"} == 1) or vector(0)

    stat-unhealthy-operators:
      kind: Panel
      spec:
        display:
          name: "Unhealthy Cluster Operators"
          description: "Aantal Cluster Operators die down, degraded of unavailable zijn."
        plugin:
          kind: StatChart
          spec:
            calculation: last
            queries:
              - kind: PrometheusTimeSeriesQuery
                spec:
                  query: count(cluster_operator_up == 0 or cluster_operator_conditions{condition="Degraded", status="true"} == 1 or cluster_operator_conditions{condition="Available", status="false"} == 1) or vector(0)

    stat-deprecated-apis:
      kind: Panel
      spec:
        display:
          name: "Actieve Deprecated APIs"
          description: "Aantal resources dat uitgefaseerde API-versies aanroept."
        plugin:
          kind: StatChart
          spec:
            calculation: last
            queries:
              - kind: PrometheusTimeSeriesQuery
                spec:
                  query: count(sum by (resource) (rate(apiserver_requested_deprecated_apis[15m])) > 0) or vector(0)

    # --- Detail Rij 1: PDBs & Node Readiness (TimeSeriesChart) ---
    pdbs-blocking-detail:
      kind: Panel
      spec:
        display:
          name: "Pod Disruption Budgets met 0 Disruptions Allowed"
          description: "Specifieke PDBs per namespace die drains verhinderen."
        plugin:
          kind: TimeSeriesChart
          spec:
            queries:
              - kind: PrometheusTimeSeriesQuery
                spec:
                  query: sum by (namespace, poddisruptionbudget) (kube_poddisruptionbudget_status_pod_disruptions_allowed == 0)

    nodes-unready-detail:
      kind: Panel
      spec:
        display:
          name: "Node Readiness Status (Non-Ready Nodes)"
          description: "Overzicht van specifieke nodes die niet in Ready-status verkeren."
        plugin:
          kind: TimeSeriesChart
          spec:
            queries:
              - kind: PrometheusTimeSeriesQuery
                spec:
                  query: sum by (node) (kube_node_status_condition{condition="Ready", status!="true"} == 1)

    # --- Detail Rij 2: Operators & Deprecated APIs (TimeSeriesChart) ---
    unhealthy-operators-detail:
      kind: Panel
      spec:
        display:
          name: "Gedegradeerde Cluster Operators (Per Operator)"
          description: "Overzicht van gedegradeerde OpenShift Cluster Operators."
        plugin:
          kind: TimeSeriesChart
          spec:
            queries:
              - kind: PrometheusTimeSeriesQuery
                spec:
                  query: sum by (name) (cluster_operator_conditions{condition="Degraded", status="true"} == 1)

    deprecated-apis-detail:
      kind: Panel
      spec:
        display:
          name: "Deprecated APIs in Gebruik (Per Resource/Groep)"
          description: "Aanroepen van deprecated API-endpoints over de tijd."
        plugin:
          kind: TimeSeriesChart
          spec:
            queries:
              - kind: PrometheusTimeSeriesQuery
                spec:
                  query: sum(rate(apiserver_requested_deprecated_apis[5m])) by (resource, group, version)

  layouts:
    - kind: Grid
      spec:
        items:
          # Bovenste rij: 4 stat blokken (breedte 6 per stuk = 24 breedte)
          - x: 0
            y: 0
            width: 6
            height: 4
            content:
              $ref: "#/panels/stat-blocking-pdbs"
          - x: 6
            y: 0
            width: 6
            height: 4
            content:
              $ref: "#/panels/stat-unready-nodes"
          - x: 12
            y: 0
            width: 6
            height: 4
            content:
              $ref: "#/panels/stat-unhealthy-operators"
          - x: 18
            y: 0
            width: 6
            height: 4
            content:
              $ref: "#/panels/stat-deprecated-apis"

          # Rij 2: PDB en Node grafieken (breedte 12 per stuk)
          - x: 0
            y: 4
            width: 12
            height: 7
            content:
              $ref: "#/panels/pdbs-blocking-detail"
          - x: 12
            y: 4
            width: 12
            height: 7
            content:
              $ref: "#/panels/nodes-unready-detail"

          # Rij 3: Operator en API grafieken (breedte 12 per stuk)
          - x: 0
            y: 11
            width: 12
            height: 7
            content:
              $ref: "#/panels/unhealthy-operators-detail"
          - x: 12
            y: 11
            width: 12
            height: 7
            content:
              $ref: "#/panels/deprecated-apis-detail"
